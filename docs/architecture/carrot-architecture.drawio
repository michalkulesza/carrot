="220" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page2" name="2 · Import Pipeline"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1750" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="User: paste URL · iOS share sheet ·&lt;br&gt;paste text · photo of a recipe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="300" height="70" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;POST /api/imports/jobs&lt;/b&gt;&lt;br&gt;{kind, input, idempotency_key, model?}&lt;br&gt;idempotent on (user_id, idempotency_key) → 200 on replay&lt;br&gt;429 import_queue_full when ≥20 active jobs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="380" height="110" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;import_jobs&lt;/b&gt; status=pending&lt;br&gt;+ import_job_events: import_job.created" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="60" y="320" width="380" height="80" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;worker&lt;/b&gt; — 3 concurrent loops, poll 2 s&lt;br&gt;SELECT … FOR UPDATE SKIP LOCKED&lt;br&gt;status=pending AND next_attempt_at ≤ now&lt;br&gt;→ running + event" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="440" width="380" height="110" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;load context&lt;/b&gt;&lt;br&gt;household tags (household-scoped ∪ defaults)&lt;br&gt;allergens = household.allergens ∪ personal_allergens&lt;br&gt;re-ve