nced&#x27;&lt;br&gt;map tag names → household tags&lt;br&gt;build components JSONB (all 4 variant arrays + flags + step refs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=center;" vertex="1" parent="1"><mxGeometry x="1740" y="1220" width="380" height="130" as="geometry"/></mxCell><mxCell id="n24" value="&lt;b&gt;recipes&lt;/b&gt; row&lt;br&gt;+ recipe_households link  + recipe_tags&lt;br&gt;+ recipe_embeddings (pending)" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1740" y="1390" width="380" height="90" as="geometry"/></mxCell><mxCell id="n25" value="job → &lt;b&gt;succeeded&lt;/b&gt;&lt;br&gt;input cleared, result_recipe_id set&lt;br&gt;event import_job.succeeded" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=center;" vertex="1" parent="1"><mxGeometry x="1740" y="1520" width="380" height="80" as="geometry"/></mxCell><mxCell id="n26" value="&lt;b&gt;_fail_or_retry&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=center;" vertex="1" parent="1"><mxGeometry x="700" y="1420" width="200" height="60" as="geometry"/></mxCell><mxCell id="n27" value="transient?&lt;br&gt;network/timeout/429/500/503" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;" vertex="1" parent="1"><mxGeometry x="640" y="1520" width="320" height="90" as="geometry"/></mxCell><mxCell id="n28" value="retry_count &lt; 3 →&lt;br&gt;pending, next_attempt_at = now + 30 s&lt;br&gt;event retry_scheduled" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=center;" vertex="1" parent="1"><mxGeometry x="240" y="1520" width="340" height="90" as="geometry"/></mxCell><mxCell id="n29" value="status=&lt;b&gt;failed&lt;/b&gt; + failure_code&lt;br&gt;extraction_failed · user_action_required ·&lt;br&gt;retries_exh