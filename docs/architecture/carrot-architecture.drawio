gt;&lt;br&gt;name · yield_note · ingredients[] (display) · shopping_list_ingredients[] · shopping_list_categories[]&lt;br&gt;steps[] · metric_ingredients[] · imperial_ingredients[] · metric_steps[] · imperial_steps[]&lt;br&gt;ingredient_flags[{allergen, substitute, substitute_applied, original_display}]&lt;br&gt;step_ingredient_refs[step][{ingredient_index, mention, display?}]" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffcc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="1050" width="620" height="160" as="geometry"/></mxCell><mxCell id="n70" value="&lt;b&gt;Import cache is currently disabled&lt;/b&gt;&lt;br&gt;_IMPORT_CACHE_ENABLED = False in pipeline.py&lt;br&gt;(TTL cache module still present)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffcc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="1250" width="620" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page3" name="3 · Gemini Prompt Chain"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1620" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="g22" value="Allergen pass — only when allergens are declared" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9e9e9e;dashed=1;verticalAlign=top;align=left;spacing=8;fontStyle=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="640" height="400" as="geometry"/></mxCell><mxCell id="g13" value="Deterministic repair — no model call" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9e9e9e;dashed=1;verticalAlign=top;align=left;spacing=8;fontStyle=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="720" y="800" width="1220" height="400" as="geometry"/></mxCell><mxCell id="g7" value="Phase C — step references (gemini-2.5-flash-lite)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9e9e9e;dashed=1;verticalAlign=top;align=left;spacing=8;fontStyle=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="1240" width="1300" height="300" as="geometry"/></mxCell><mxCell id="g4" value="Phase B — enrichment (gemini-2.5-flash-lite)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9e9e9e;dashed=1;verticalAlign=top;align=left;spacing=8;fontStyle=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="720" y="60" width="660" height="700" as="geometry"/></mxCell><mxCell id="g1" value="Phase A — faithful extraction" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9e9e9e;dashed=1;verticalAlign=top;align=left;spacing=8;fontStyle=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="620" height="560" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;_EXTRACTION_SYSTEM&lt;/b&gt;&lt;br&gt;model: settings.gemini_extraction_model (gemini-2.5-flash)&lt;br&gt;temperature 0 · response_schema = RecipeSourceExtraction&lt;br&gt;―&lt;br&gt;Preserve the original language.&lt;br&gt;Only what is explicitly in the source: never add ingredients,&lt;br&gt;change stated numbers, estimate, convert units, round, infer&lt;br&gt;steps, calculate nutrition, assign tags, detect allergens,&lt;br&gt;or add references.&lt;br&gt;One component per explicit section.&lt;br&gt;Servings only when stated (range → midpoint).&lt;br&gt;Units restricted to a 14-value enum (ml l tsp tbsp cup g kg&lt;br&gt;clove slice can bunch pinch sprig handful); anything else stays&lt;br&gt;whole in &lt;i&gt;name&lt;/i&gt; with null qty/unit.&lt;br&gt;Keep punctuation faithful — no invented parentheticals." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="110" width="560" height="330" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;RecipeSourceExtraction&lt;/b&gt;&lt;br&gt;title · servings · components[]&lt;br&gt;component: role, name, yield_note, ingredients[{qty, unit, name}], steps[]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=center;" vertex="1" parent="1"><mxGeometry x="70" y="470" width="560" height="110" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;_ENRICHMENT_SYSTEM&lt;/b&gt;  (embeds &lt;b&gt;_UNIT_CONVERSION_SYSTEM&lt;/b&gt;)&lt;br&gt;temperature 0 · response_schema = RecipeEnrichment&lt;br&gt;input = {source_recipe, available_tags?}&lt;br&gt;―&lt;br&gt;Source title/servings/ingredients/steps are authoritative:&lt;br&gt;never add, remove, reorder, alter, or return them.&lt;br&gt;&lt;br&gt;&lt;b&gt;Units&lt;/b&gt;  metric = g/kg/ml/l/°C · imperial = cups/tbsp/tsp/°F&lt;br&gt;tsp &amp;amp; tbsp are NEVER converted · cup → ingredient-specific whole&lt;br&gt;grams, no ranges · inches → cm&lt;br&gt;Counts stay counts in BOTH variants (onion, clove, stalk, slice,&lt;br&gt;cube, bunch, sprig, pinch): &#x27;1/2 sweet onion&#x27; never &#x27;125 g&#x27;.&lt;br&gt;Cans are the exception — metric estimates drained weight and&lt;br&gt;keeps &#x27;(1 can)&#x27;; imperial keeps the can.&lt;br&gt;&lt;br&gt;&lt;b&gt;shopping_list_value&lt;/b&gt; — round UP indivisible items (0.5 onion&lt;br&gt;→ 1 onion); never round weights/volumes&lt;br&gt;&lt;b&gt;shopping_list_category&lt;/b&gt; — one of 6 stable IDs, never a label&lt;br&gt;&lt;b&gt;total_time_minutes&lt;/b&gt; — active kitchen time, excludes passive rest&lt;br&gt;&lt;b&gt;kcal/protein/fat/carbs&lt;/b&gt; — REQUIRED, estimated when unstated&lt;br&gt;&lt;b&gt;tags&lt;/b&gt; — only from available_tags, never invented" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="750" y="110" width="600" height="470" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;RecipeEnrichment&lt;/b&gt; — parallel arrays per component&lt;br&gt;metric_ingredients · imperial_ingredients · metric_steps · imperial_steps&lt;br&gt;shopping_list_values · shopping_list_categories&lt;br&gt;+ total_time_minutes, macros, tags" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=center;" vertex="1" parent="1"><mxGeometry x="750" y="610" width="600" height="130" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;_STEP_REFERENCE_SYSTEM&lt;/b&gt;&lt;br&gt;temperature 0 · response_schema = RecipeStepReferences&lt;br&gt;input = {source_recipe} · skipped when no component has BOTH&lt;br&gt;ingredients and steps&lt;br&gt;―&lt;br&gt;Components, ingredient indexes and step indexes are authoritative.&lt;br&gt;Link only when the step explicitly names the ingredient, an unambiguous&lt;br&gt;key noun, plural, abbreviation, or inflected form — and the mention is an&lt;br&gt;exact substring of the step.&lt;br&gt;Never infer from &#x27;the ingredients&#x27;, &#x27;the mixture&#x27;, &#x27;combine&#x27;, &#x27;seasoning&#x27;.&lt;br&gt;display carries a divided ingredient&#x27;s portion, otherwise null.&lt;br&gt;Matches inflected languages (pl, ru, cz, de)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="1290" width="620" height="220" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;RecipeStepReferences&lt;/b&gt;&lt;br&gt;components[].step_refs[{step_index, ingredient_index, mention, display?}]&lt;br&gt;invalid response → empty; the recipe still saves, just without refs&lt;br&gt;→ _repair_step_refs runs on this output" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=center;" vertex="1" parent="1"><mxGeometry x="740" y="1290" width="580" height="110" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;Uncommitted at time of writing.&lt;/b&gt; Step references used to be one more&lt;br&gt;field on the enrichment response. RecipeEnrichment still carries step_refs,&lt;br&gt;but assemble_recipe prefers the Phase C result when it is passed one." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffcc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="740" y="1420" width="580" height="90" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;validation loop — up to 3 attempts&lt;/b&gt;&lt;br&gt;parses? schema-valid?&lt;br&gt;total_time_minutes present when there is content?&lt;br&gt;_validate_metric_ingredients: no cup/lb/oz/inch left&lt;br&gt;without a metric unit" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;" vertex="1" parent="1"><mxGeometry x="1440" y="110" width="500" height="130" as="geometry"/></mxCell><mxCell id="n12" value="re-prompt with &lt;b&gt;previous_validation_error&lt;/b&gt;&lt;br&gt;&#x27;regenerate every enrichment field from source_recipe,&lt;br&gt;preserving exact component/ingredient/step counts&#x27;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=center;" vertex="1" parent="1"><mxGeometry x="1440" y="290" width="500" height="90" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;_repair_enrichment_alignment&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=center;" vertex="1" parent="1"><mxGeometry x="750" y="850" width="320" height="50" as="geometry"/></mxCell><mxCell id="n15" value="array length ≠ source length → fall back to source values" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=center;" vertex="1" parent="1"><mxGeometry x="750" y="920" width="560" height="40" as="geometry"/></mxCell><mxCell id="n16" value="_repair_unconverted_metric_ingredients → source value" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=center;" vertex="1" parent="1"><mxGeometry x="750" y="970" width="560" height="40" as="geometry"/></mxCell><mxCell id="n17" value="_preserve_spoon_measurements — tsp/tbsp lines revert to source" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=center;" vertex="1" parent="1"><mxGeometry x="750" y="1020" width="560" height="40" as="geometry"/></mxCell><mxCell id="n18" value="_preserve_discrete_ingredient_measurements — count-based lines revert&lt;br&gt;(cans exempt in metric; lines with an inline convertible measure pass through)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=center;" vertex="1" parent="1"><mxGeometry x="750" y="1070" width="560" height="50" as="geometry"/></mxCell><mxCell id="n19" value="_repair_shopping_list_categories — unknown/missing → &#x27;other&#x27;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=center;" vertex="1" parent="1"><mxGeometry x="750" y="1130" width="560" height="40" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b&gt;_repair_step_refs&lt;/b&gt;  (runs on the Phase C output)&lt;br&gt;drop out-of-range refs · mention must be an exact normalised substring&lt;br&gt;of the step · drop generic mentions (&#x27;ingredients&#x27;, &#x27;mixture&#x27;, &#x27;seasoning&#x27;)&lt;br&gt;· remap to the best-scoring ingredient when unambiguous · dedupe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=center;" vertex="1" parent="1"><mxGeometry x="1360" y="920" width="560" height="110" as="geometry"/></mxCell><mxCell id="n21" value="&lt;b&gt;assemble_recipe&lt;/b&gt;(source, enrichment, step_references)&lt;br&gt;strict re-check of every array length and ref range —&lt;br&gt;raises rather than saving a misaligned recipe&lt;br&gt;→ RecipeExtraction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=center;" vertex="1" parent="1"><mxGeometry x="1360" y="1070" width="560" height="100" as="geometry"/></mxCell><mxCell id="n23" value="&lt;b&gt;_ALLERGEN_SYSTEM&lt;/b&gt; (flash-lite)&lt;br&gt;numbered ingredient list + allergen list&lt;br&gt;―&lt;br&gt;Report only with reliable evidence in the ingredient text.&lt;br&gt;Generic sauces/stocks/pastes/marinades are NOT proof of gluten:&lt;br&gt;&#x27;chili garlic sauce&#x27; no · &#x27;chili garlic sauce containing wheat&#x27; yes.&lt;br&gt;Substitute must RE-SCALE amounts, not copy the original numbers&lt;br&gt;(⅓ cup peanut butter → ¼ cup tahini)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="850" width="580" height="200" as="geometry"/></mxCell><mxCell id="n24" value="&lt;b&gt;_discard_unsubstantiated_allergen_flags&lt;/b&gt;&lt;br&gt;clear the flag when the text says &#x27;gluten-free&#x27;, or when a&lt;br&gt;variable-formulation product was flagged gluten/ncgs without an&lt;br&gt;explicit wheat/barley/rye/malt/flour/soy-sauce/… token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=center;" vertex="1" parent="1"><mxGeometry x="70" y="1070" width="580" height="100" as="geometry"/></mxCell><mxCell id="n25" value="&lt;b&gt;_TRANSCRIPTION_SYSTEM&lt;/b&gt; (gemini-2.5-flash, temp 0)&lt;br&gt;near-verbatim, auto-detect language, never translate or summarise,&lt;br&gt;preserve every action/amount/temperature/correction and code-switching,&lt;br&gt;never infer from title/caption/visuals, [inaudible] instead of guessing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="620" height="120" as="geometry"/></mxCell><mxCell id="n26" value="&lt;b&gt;_with_retry&lt;/b&gt;&lt;br&gt;backoff on 429/503/UNAVAILABLE/RESOURCE_EXHAUSTED&lt;br&gt;1·2·4·8 s — or the &#x27;generous&#x27; ladder to 60 s for backfills" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffcc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="1440" y="430" width="500" height="90" as="geometry"/></mxCell><mxCell id="n27" value="&lt;b&gt;UsageTracker&lt;/b&gt;&lt;br&gt;input/output tokens + call count&lt;br&gt;accumulated across every Gemini call in one import" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffcc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="1440" y="550" width="500" height="80" as="geometry"/></mxCell><mxCell id="n28" value="&lt;b&gt;Same prompts, reused by backfill scripts&lt;/b&gt;&lt;br&gt;_UNIT_CONVERSION_SYSTEM → estimate_unit_variants()&lt;br&gt;→ scripts/backfill_unit_variants.py&lt;br&gt;recommend_shopping_list_values() → backfill_shopping_list_values.py&lt;br&gt;recommend_shopping_list_categories() → backfill_shopping_list_categories.py" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffcc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="1440" y="660" width="500" height="120" as="geometry"/></mxCell><mxCell id="e29" value="video path only" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=blockThin;endFill=1;dashed=1;strokeColor=#999999;" edge="1" parent="1" source="n25" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="n3" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="n3" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="n9" target="n20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="n6" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e37" value="invalid, attempt &lt; 3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="n11" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="n12" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e39" value="valid — or attempt 3 with metric-only errors" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="n11" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=blockThin;endFill=1;